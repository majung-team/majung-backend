[Unit]
Description=Majung pickup API (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=majung
Group=majung
WorkingDirectory=/opt/majung
EnvironmentFile=/etc/majung/server.env
ExecStart=/usr/local/libexec/majung-slot %i
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=640M
MemoryMax=768M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
