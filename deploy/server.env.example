# Copy outside the repository (for example /etc/majung/server.env), chmod 600.
SPRING_PROFILES_ACTIVE=deploy
PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/majung
DB_USER=majung_app
# Fill these on the host. An empty admin key prevents the deploy profile from starting.
DB_PASSWORD=
MAJUNG_ADMIN_KEY=

# Kakao credentials are supplied only on the server, never in web or vehicle builds.
# Keep login disabled until the callback, account lifecycle and deployed code are verified.
MAJUNG_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://majung.cloud/api/v1/auth/callback/kakao
# Primary Kakao admin key for authenticated unlink notifications (server only).
KAKAO_ADMIN_KEY=
KAKAO_APP_ID=
